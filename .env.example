# ==============================================================================
# Araya Business Hub Platform — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your actual local/staging credentials.
# NEVER commit the actual .env file with real credentials to version control!
# ==============================================================================

# Application port and environment
PORT=8080
APP_ENV=development # development | staging | production | test

# Database configuration (PostgreSQL / Supabase connection URL)
# Example Supabase pooled connection string:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/araya_hub?sslmode=disable

# Authentication & Security
# Secret key used for signing platform JWTs (minimum 32 characters in production)
JWT_SECRET=super_secret_jwt_signing_key_for_araya_hub_local_dev_only

# JWT Expiration in hours (conforming to PRD v1.0 standard: 8 hours)
JWT_EXPIRATION_HOURS=8

# Service-to-Service key for inter-module authorization without user context (X-Service-Key)
SERVICE_KEY=secret_service_key_for_cross_module_communication

# Allowed CORS origins (comma-separated, e.g. frontend dev and production URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://araya-hub.vercel.app
